{
  "manifest_version": 3,
  "name": "OEM Precificação ML",
  "version": "0.1.0",
  "description": "Simula margens e avalia promoções da conta OEM no Mercado Livre.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://olist-dash.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OEM Precificação ML",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*"],
      "js": ["assets/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
