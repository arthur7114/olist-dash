{
  "name": "@oem/ml-pricing-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts && node scripts/validate-build.mjs",
    "package": "pnpm build && mkdir -p release && cd dist && zip -qr ../release/oem-ml-pricing-extension-0.1.0.zip .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oem/contracts": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "typescript": "^5.7.3",
    "vite": "latest",
    "vitest": "^4.1.9"
  }
}
